{
  "name": "unicornt-store-frontend",
  "version": "2.0.0",
  "description": "Unicorn't Store - Frontend (Vite + TypeScript estricto)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:report": "vitest run --coverage --reporter=default --reporter=html --outputFile.html=./html/index.html",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "process-images": "node scripts/process-images.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^26.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.33.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8"
  }
}
